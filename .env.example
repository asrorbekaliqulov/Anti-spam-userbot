# ============================================================
#  Anti-Spam Agent Platform - Environment configuration
#  Copy this file to ".env" and fill in the real values.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Telegram API credentials (https://my.telegram.org/apps) ---
# These are the DEFAULT credentials used when creating a new userbot via the
# dashboard. Each UserBot row may also override them with its own api_id/hash.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- OpenAI (3rd stage hybrid filter) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Behaviour tuning ---
# Seconds to wait between QR token refreshes (Telegram tokens last ~30s).
QR_TOKEN_REFRESH=25
# Base async delay (seconds) applied between sensitive Telegram actions to
# stay well under FloodWait limits during propagation/admin promotion.
ACTION_THROTTLE_SECONDS=2
